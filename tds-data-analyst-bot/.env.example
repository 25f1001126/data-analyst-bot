# Telegram
TELEGRAM_BOT_TOKEN=

# Groq (tried first) -- console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (fallback if Groq errors/rate-limits) -- openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Must match wherever this app is actually deployed + reachable publicly.
# This exact URL is injected into every JSON answer's "log_url" field.
PUBLIC_LOG_URL=https://your-app.onrender.com/run.jsonl

# Where the JSONL log is written on disk (mount a persistent volume in prod
# if your host wipes the filesystem on restart)
LOG_PATH=/data/run.jsonl

PORT=8080
